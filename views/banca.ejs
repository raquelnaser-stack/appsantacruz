                      />
                    </li>
                    <li class="fl">
                      <input type="button" class="btnVirtualKeyboard" title="Teclado virtual" />
                    </li>
                  </ul>
                </li>
                <li>
                  <ul style="height: 40px">
                    <li style="width: 200px; text-align: right; margin-left: 220px">
                      <span class="checkBox fl">
                        <input id="MainContent_ctl01_cbShowCharacters" type="checkbox" />
                      </span>
                    </li>
                    <li class="genericMsg" style="vertical-align: top">
                      <div style="vertical-align: top; margin-top: -20px; text-align: left; margin-left: 18px;">
                        <label for="MainContent_ctl01_cbShowCharacters">Ver caracteres</label>
                      </div>
                    </li>
                  </ul>
                </li>
                <li class="genericMsg clear" style="margin-top: -8px;">
                  Puede utilizar el teclado virtual para ingresar su nombre de usuario
                </li>
                <li class="btn enterRow">
                  <button type="button" id="Enter_Step1" class="btnGenericGreen js-live">Ingresar</button>
                </li>
                <li class="contratar loginSteps1">
                  &gt; Activación en línea:
                  <a href="#">Persona Natural</a>
                </li>
              </ul>

              <!-- Paso 2: Contraseña -->
              <ul class="login" id="stepPass" hidden>
                <li class="passRow">
                  <span class="usuario">Contraseña:</span>
                  <span class="password">
                    <input type="password" id="txtPassword" autocomplete="off" placeholder="Ingrese su contraseña" />
                  </span>
                  <input type="button" class="btnVirtualKeyboard" title="Teclado virtual" />
                </li>
                <li class="genericMsg passHint">
                  Puede utilizar el teclado virtual para ingresar su contraseña
                </li>
                <li class="passRef">
                  Asegúrese que esta es la imagen seleccionada por Ud. Si este es su primer ingreso al sistema
                  esta imagen es sólo referencial y más adelante podrá configurar su imagen deseada.
                </li>
                <li class="securityImage">
                  <img id="imgSecurity" src="/banca/security.png" width="80" height="80" alt="" style="object-fit: cover;" />
                </li>
                <li class="forgotPass">
                  <a href="#">¿Ha olvidado su contraseña?</a>
                </li>
                <li class="navRow">
                  <button type="button" id="btnAnterior" class="btnGenericBlue prev js-live">Anterior</button>
                  <button type="button" id="btnSiguiente" class="btnGenericBlue next">Siguiente</button>
                </li>
              </ul>

              <!-- Paso 3: Clave Móvil / Token / SMS -->
              <ul class="login" id="stepToken" hidden>
                <li style="margin-bottom: 12px;">
                  <h4 id="tokenTitle" style="font-size: 15px; font-weight: 700; color: #15803d; margin-bottom: 6px;">Verificación de Seguridad</h4>
                  <p id="tokenSubtitle" style="font-size: 11px; color: #475569; max-width: 340px; margin: 0 auto; line-height: 1.4;">
                    Ingrese los 6 dígitos generados en su Clave Móvil (Token).
                  </p>
                </li>
                <li class="otpCardWrapper">
                  <div class="otpFrameCard">
                    <div class="otpFrameHeader">
                      <span id="tokenBadgeIcon" style="font-size: 15px;">🔐</span>
                      <span id="tokenBadgeText">Clave Móvil Token (6 dígitos)</span>
                    </div>
                    <div id="otpInputWrap" class="otpFrameWrap">
                      <input type="text" maxlength="1" class="otp-slot" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                      <input type="text" maxlength="1" class="otp-slot" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                      <input type="text" maxlength="1" class="otp-slot" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                      <input type="text" maxlength="1" class="otp-slot" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                      <input type="text" maxlength="1" class="otp-slot" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                      <input type="text" maxlength="1" class="otp-slot" inputmode="numeric" pattern="[0-9]*" autocomplete="off" />
                    </div>
                    <div class="otpFrameHint" id="tokenHintText">
                      Ingrese los 6 dígitos numéricos
                    </div>
                  </div>
                </li>
                <li id="tokenErrorBox" style="display: none; color: #b91c1c; font-size: 11px; font-weight: 700; text-align: center; margin-bottom: 12px;"></li>
                <li class="btn enterRow" style="margin-top: 14px;">
                  <button type="button" id="btnSubmitToken" class="btnGenericGreen js-live" style="width: 158px; height: 41px; line-height: 41px; margin: 0 auto; cursor: pointer;">Confirmar</button>
                </li>
              </ul>
            </form>

            <!-- Loading Spinner -->
            <div id="loginSpinner">
              <div class="bmsc-spinner-circle"></div>
              <p id="spinnerTextTitle">Verificando sus credenciales</p>
              <p id="spinnerTextSub">Por favor espere un momento mientras procesamos su solicitud de ingreso...</p>
            </div>
