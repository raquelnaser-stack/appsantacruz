<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <section class="page-hero">
        <div class="container">
          <p class="eyebrow"><%= page.eyebrow %></p>
          <h1><%= page.title %></h1>
          <p class="lead"><%= page.lead %></p>
        </div>
      </section>
      <section class="page-body">
        <div class="container highlight-grid">
          <% page.highlights.forEach((item) => { %>
          <article class="highlight-card">
            <p><%= item %></p>
          </article>
          <% }) %>
        </div>
        <div class="container page-cta">
          <a class="btn btn-lime" href="/contactanos">Hablar con un ejecutivo →</a>
          <a class="btn btn-forest" href="/banca-24-7">Ir a Banca 24/7</a>
        </div>
      </section>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
