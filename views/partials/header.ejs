<header class="site-header">
  <div class="header-top">
    <a class="brand" href="/" aria-label="Mercantil Santa Cruz">
      <img src="/img/logo.svg" alt="" width="46" height="46" />
      <span>Mercantil Santa Cruz</span>
    </a>
    <button class="menu-toggle" type="button" aria-label="Abrir menú" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <div class="header-tools">
      <nav class="segment-nav" aria-label="Segmentos">
        <% segments.forEach((item) => { %>
        <a class="<%= (segment === item.id || currentPath === '/' + item.id) ? 'is-active' : '' %>" href="<%= item.href %>"><%= item.label %></a>
        <% }) %>
      </nav>
      <a class="btn btn-orange" href="/mis-productos">Mis Productos</a>
      <a class="btn btn-forest" href="/banca-24-7">Banca por Internet</a>
    </div>
  </div>
  <nav class="product-nav" aria-label="Productos">
    <% nav.forEach((item) => { %>
    <a class="<%= currentPath === '/' + item.slug ? 'is-active' : '' %>" href="/<%= item.slug %>"><%= item.label %></a>
    <% }) %>
  </nav>
</header>
