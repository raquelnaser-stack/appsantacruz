<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>
    <link rel="icon" href="/img/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/styles.css" />
  </head>
  <body>
    <%- include('partials/header') %>
    <main>
      <section class="hero">
        <button class="hero-arrow prev" type="button" aria-label="Anterior" data-dir="-1"><span></span></button>
        <div class="container hero-grid">
          <div class="hero-copy">
            <% slides.forEach((slide, i) => { %>
            <article class="hero-slide<%= i === 0 ? ' is-active' : '' %>" data-slide="<%= i %>">
              <h1><%= slide.title %></h1>
              <% if (slide.kickerTitle) { %><p class="hero-kicker-title"><%= slide.kickerTitle %></p><% } %>
              <% if (slide.text) { %><p class="hero-text"><%= slide.text %></p><% } %>
              <div class="hero-actions">
                <a class="btn btn-lime" href="<%= slide.href %>"><%= slide.cta %> <span>→</span></a>
                <% if (slide.note) { %><p class="hero-note"><%= slide.note %></p><% } %>
              </div>
            </article>
            <% }) %>
          </div>
          <div class="hero-visual">
            <% slides.forEach((slide, i) => { %>
            <figure class="promo-card<%= i === 0 ? ' is-active' : '' %>" data-slide="<%= i %>">
              <span class="promo-kicker"><%= slide.kicker %></span>
              <img src="<%= slide.image %>" alt="<%= slide.title %>" />
            </figure>
            <% }) %>
          </div>
        </div>
        <button class="hero-arrow next" type="button" aria-label="Siguiente" data-dir="1"><span></span></button>
        <div class="hero-dots" role="tablist" aria-label="Carrusel">
          <% slides.forEach((_, i) => { %>
          <button type="button" class="dot<%= i === 0 ? ' is-active' : '' %>" data-go="<%= i %>" aria-label="Slide <%= i + 1 %>"></button>
          <% }) %>
        </div>
      </section>

      <section class="needs">
        <div class="container">
          <h2>¿Qué necesitas hoy?</h2>
          <div class="needs-track">
            <% services.forEach((item) => { %>
            <a class="need-card" href="<%= item.href %>">
              <span class="need-icon icon-<%= item.icon %>" aria-hidden="true"></span>
              <h3><%= item.title %></h3>
              <p><%= item.text %></p>
            </a>
            <% }) %>
          </div>
        </div>
      </section>

      <section class="promos">
        <div class="container promo-grid">
          <% promos.forEach((promo) => { %>
          <article class="spotlight">
            <img src="<%= promo.image %>" alt="" />
            <div class="spotlight-body">
              <h3><%= promo.title %></h3>
              <p><%= promo.text %></p>
              <a class="btn btn-lime" href="<%= promo.href %>"><%= promo.cta %></a>
            </div>
          </article>
          <% }) %>
        </div>
      </section>

      <section class="digital">
        <div class="container digital-grid">
          <article>
            <h2>Ir al banco, ¡sin ir al banco!</h2>
            <p>Abre tu cuenta o solicita tu crédito de manera online desde donde estés.</p>
            <a class="text-link" href="/banca-24-7">Haz clic aquí</a>
          </article>
          <article>
            <h2>RSE</h2>
            <p>El BMSC impulsa programas de apoyo social para beneficiar a los sectores más vulnerables del país. Te invitamos a apoyarnos.</p>
            <a class="text-link" href="/contactanos">Ver más</a>
          </article>
        </div>
      </section>

      <section class="channels">
        <div class="container channels-grid">
          <% channels.forEach((item) => { %>
          <a class="channel-card" href="<%= item.href %>">
            <img src="<%= item.image %>" alt="" />
            <h3><%= item.title %></h3>
          </a>
          <% }) %>
        </div>
      </section>

      <section class="help-band">
        <div class="container help-grid">
          <div>
            <h3>Banca 24/7</h3>
            <h4>Ahorra tiempo</h4>
            <p>Pensando en tu bienestar y comodidad ponemos a tu disposición nuestros canales digitales, donde podras realizar todas tus operaciones bancarias sin necesidad de visitar nuestras agencias.</p>
          </div>
          <div>
            <h4>Descarga nuestra app</h4>
            <p>Valoramos tu tiempo. Descarga nuestra app de Banca Móvil y completa tus principales transacciones de manera ágil, cómoda y segura, desde la comodidad de tu celular.</p>
          </div>
          <div>
            <h4>¿Cómo podemos ayudarte?</h4>
            <a class="help-link" href="/contactanos">Agencias y cajeros</a>
            <a class="help-link" href="/contactanos">Preguntas frecuentes</a>
            <a class="help-link" href="/contactanos">Punto de reclamo</a>
          </div>
        </div>
      </section>
    </main>
    <%- include('partials/footer') %>
    <script src="/js/main.js"></script>
  </body>
</html>
